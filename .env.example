# ---------- core ----------
NEXUS_ENV=local
NEXUS_LOG_LEVEL=INFO
NEXUS_SECRET_KEY=change-me-32-bytes-minimum-for-local-dev

# ---------- database ----------
NEXUS_DATABASE__URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
NEXUS_DATABASE__POOL_SIZE=10

# ---------- redis ----------
NEXUS_REDIS__URL=redis://localhost:6379/0

# ---------- object storage (MinIO locally, S3 in production) ----------
NEXUS_STORAGE__ENDPOINT=http://localhost:9000
NEXUS_STORAGE__ACCESS_KEY=minioadmin
NEXUS_STORAGE__SECRET_KEY=minioadmin
NEXUS_STORAGE__BUCKET=nexus-documents

# ---------- telemetry ----------
NEXUS_TELEMETRY__ENABLED=true
NEXUS_TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
NEXUS_TELEMETRY__SAMPLE_RATE=1.0

# ---------- providers ----------
# The mock provider always works and needs no key. Leave the others blank until
# you want them; the registry only loads providers that are configured.
NEXUS_PROVIDERS__OPENAI_API_KEY=
NEXUS_PROVIDERS__ANTHROPIC_API_KEY=
NEXUS_PROVIDERS__AZURE_OPENAI_API_KEY=
NEXUS_PROVIDERS__AZURE_OPENAI_ENDPOINT=

# ---------- auth (OIDC) ----------
NEXUS_AUTH__ISSUER=http://localhost:8080/realms/nexus
NEXUS_AUTH__CLIENT_ID=nexus-console
NEXUS_AUTH__CLIENT_SECRET=
NEXUS_AUTH__DEV_BYPASS=true

# ---------- mlflow ----------
MLFLOW_TRACKING_URI=http://localhost:5000
